<section class="consultor" id="el-consultor">
	<div class="consultor__inner container">
		<div class="consultor__visual animate-on-scroll">
			<img src="/images/consultor.png" alt="El consultor" class="consultor__image" />
		</div>

		<div class="consultor__content animate-on-scroll">
			<h2 class="consultor__title">El consultor</h2>
			<p class="consultor__text consultor__text--bold-italic">
				Desde el 2000 he liderado diversos proyectos de consultoría y asesoría a más de 220 empresas privadas y públicas de la región.
			</p>
			<p class="consultor__text consultor__text--italic">
				<br>
				Proyectos de desarrollo de nuevos negocios.<br>
				Programas de desarrollo y transformación organizacional.<br>
				Agendas estratégicas de crecimiento exponencial.<br>
				Programas de desarrollo de altos directivos y sucesión.<br>
				Estudios de mercado y planes de negocio.<br>
				Headhunting.
			</p>
		</div>
	</div>
</section>



<script>
  const consultorSvg = document.getElementById('consultor-svg');
  if (consultorSvg) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          consultorSvg.classList.add('active');
          observer.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    observer.observe(consultorSvg);
  }
</script>
