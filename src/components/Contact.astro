<section class="contact" id="contacto">
  <div class="contact__inner container">
    <!-- Botón WhatsApp -->
    <div class="contact__left animate-on-scroll">
      <button class="contact__btn" id="sendWhatsapp">
        Agendar cita
        <svg
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M12 2C6.477 2 2 6.477 2 12c0 1.89.524 3.655 1.438 5.162L2 22l4.956-1.424A9.956 9.956 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.95 7.95 0 01-4.031-1.1l-.29-.172-2.94.847.86-2.87-.19-.297A7.948 7.948 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8zm4.406-5.884c-.242-.121-1.432-.707-1.653-.788-.221-.08-.382-.12-.543.12-.16.243-.623.788-.764.949-.14.162-.281.182-.523.061-1.25-.625-2.072-1.108-2.894-2.519-.218-.376.218-.349.624-1.16.069-.14.035-.262-.02-.364-.06-.121-.543-1.31-.744-1.794-.196-.472-.395-.407-.543-.415-.14-.007-.301-.007-.462-.007-.161 0-.422.06-.644.302-.221.242-.845.825-.845 2.01s.865 2.333.985 2.494c.12.161 1.702 2.597 4.124 3.644.576.249 1.025.397 1.375.508.578.184 1.104.158 1.52.096.463-.07 1.432-.585 1.633-1.149.2-.563.2-1.045.14-1.147-.06-.1-.22-.16-.462-.281z"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Imagen -->
    <div
      class="contact__right animate-on-scroll"
      style="transition-delay:0.15s"
    >
      <img src="/images/logo-2.png" alt="nazar.mx" class="contact__img" />
    </div>
  </div>
</section>

<script>
  const send = document.getElementById("sendWhatsapp");
  if (send) {
    send.addEventListener("click", (e) => {
      e.preventDefault();
      const name = ""; // Sin campos en este diseño; mensaje directo
      const message = "Hola, me gustaría agendar una cita.";
      setTimeout(() => {
        window.location.href = `https://api.whatsapp.com/send?phone=+529616554516&text=${encodeURIComponent(message)}`;
      }, 100);
    });
  }
</script>
