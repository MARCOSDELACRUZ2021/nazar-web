---
const currentYear = new Date().getFullYear();

const navLinks = [
	{ label: 'Sobre mí', href: '#sobre-mi' },
	{ label: 'El consultor', href: '#el-consultor' },
	{ label: 'El profesor', href: '#el-profesor' },
	{ label: 'El empresario', href: '#el-empresario' },
	{ label: 'El ciudadano', href: '#el-ciudadano' },
];
---

<footer class="footer">
	<div class="footer__inner container">
		<div class="footer__main">
			<div class="footer__brand">
				<div class="footer__logo">
					<svg width="36" height="36" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
						<circle cx="16" cy="16" r="15" fill="#fff" />
						<circle cx="16" cy="16" r="10" fill="#0a0a0a" />
						<circle cx="16" cy="16" r="7" fill="#fff" />
						<circle cx="16" cy="16" r="4" fill="#0a0a0a" />
						<circle cx="16" cy="16" r="2" fill="#fff" />
					</svg>
					<span class="footer__logo-text">nazar<span class="footer__logo-dot">.mx</span></span>
				</div>
				<p class="footer__copy">© {currentYear} nazar.mx — Todos los derechos reservados.</p>
			</div>

			<nav class="footer__nav">
				<ul class="footer__nav-list">
					{navLinks.map(link => (
						<li>
							<a href={link.href} class="footer__nav-link">{link.label}</a>
						</li>
					))}
				</ul>
			</nav>
		</div>

		<div class="footer__bottom">
			<p class="footer__made">Hecho con pasión en México 🇲🇽</p>
		</div>
	</div>
</footer>


