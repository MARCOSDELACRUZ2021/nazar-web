---
const services = [
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
		title: 'Branding & Identidad',
		description: 'Construimos la identidad visual de tu marca desde cero: logotipo, paleta de colores, tipografía y manual de marca.',
		features: ['Logotipo', 'Manual de marca', 'Identidad visual'],
	},
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>`,
		title: 'Estrategia Digital',
		description: 'Diseñamos planes de marketing digital enfocados en resultados medibles que impulsan el crecimiento de tu negocio.',
		features: ['Redes sociales', 'SEO & SEM', 'Analítica'],
	},
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
		title: 'Consultoría de Marca',
		description: 'Analizamos tu marca actual y te brindamos un plan claro para posicionarte de manera efectiva en tu mercado.',
		features: ['Auditoría', 'Posicionamiento', 'Roadmap'],
	},
	{
		icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>`,
		title: 'Contenido & Storytelling',
		description: 'Creamos contenido que conecta emocionalmente con tu audiencia y cuenta la historia única de tu marca.',
		features: ['Copywriting', 'Storytelling', 'Contenido visual'],
	},
];
---

<section class="services" id="servicios">
	<div class="services__inner container">
		<div class="services__header animate-on-scroll">
			<span class="section-tag">Nuestros servicios</span>
			<h2 class="services__title">
				Todo lo que necesitas para 
				<em class="font-serif">hacer crecer</em> tu marca
			</h2>
			<p class="services__subtitle">
				Cada servicio está diseñado para aportar valor real a tu negocio, 
				con un enfoque estratégico y un toque creativo.
			</p>
		</div>

		<div class="services__grid">
			{services.map((service, index) => (
				<div class="services__card animate-on-scroll" style={`transition-delay: ${index * 0.12}s`}>
					<div class="services__card-top">
						<div class="services__card-icon" set:html={service.icon}></div>
						<span class="services__card-number">0{index + 1}</span>
					</div>
					<h3 class="services__card-title">{service.title}</h3>
					<p class="services__card-desc">{service.description}</p>
					<div class="services__card-features">
						{service.features.map(feature => (
							<span class="services__card-feature">{feature}</span>
						))}
					</div>
					<div class="services__card-arrow">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="7" y1="17" x2="17" y2="7"></line>
							<polyline points="7 7 17 7 17 17"></polyline>
						</svg>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.services {
		padding: var(--section-padding) 0;
		background: #fff;
		position: relative;
	}

	.services::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--color-border), transparent);
	}

	.services__header {
		text-align: center;
		margin-bottom: 64px;
		max-width: 560px;
		margin-left: auto;
		margin-right: auto;
	}

	.services__title {
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.03em;
		margin-bottom: 18px;
		color: var(--color-text);
	}

	.services__title em {
		color: var(--color-accent-dark);
		font-style: italic;
	}

	.services__subtitle {
		font-size: 15px;
		font-weight: 400;
		color: var(--color-text-muted);
		max-width: 460px;
		margin: 0 auto;
		line-height: 1.7;
	}

	.services__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 20px;
	}

	.services__card {
		background: var(--color-bg);
		border-radius: var(--radius-lg);
		padding: 36px 32px;
		border: 1px solid var(--color-border-light);
		transition: all var(--transition);
		cursor: default;
		position: relative;
		overflow: hidden;
	}

	.services__card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--color-accent), var(--color-accent-dark));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s ease;
	}

	.services__card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
		border-color: transparent;
	}

	.services__card:hover::before {
		transform: scaleX(1);
	}

	.services__card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 24px;
	}

	.services__card-icon {
		width: 52px;
		height: 52px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-accent-light);
		color: var(--color-accent-dark);
		border-radius: var(--radius-md);
	}

	.services__card-number {
		font-size: 13px;
		font-weight: 700;
		color: var(--color-text-light);
		letter-spacing: 0.05em;
	}

	.services__card-title {
		font-size: 20px;
		font-weight: 700;
		margin-bottom: 12px;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.services__card-desc {
		font-size: 14px;
		font-weight: 400;
		color: var(--color-text-muted);
		line-height: 1.7;
		margin-bottom: 20px;
	}

	.services__card-features {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}

	.services__card-feature {
		padding: 4px 12px;
		background: rgba(200, 169, 126, 0.1);
		color: var(--color-accent-dark);
		font-size: 11px;
		font-weight: 600;
		border-radius: var(--radius-full);
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.services__card-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--color-border-light);
		color: var(--color-text-muted);
		transition: all var(--transition);
		margin-left: auto;
	}

	.services__card:hover .services__card-arrow {
		background: var(--color-text);
		color: #fff;
		transform: rotate(0deg);
	}

	/* Tablet */
	@media (min-width: 640px) {
		.services__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Desktop */
	@media (min-width: 768px) {
		.services {
			padding: var(--section-padding-lg) 0;
		}
	}

	@media (min-width: 1024px) {
		.services__grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.services__card {
			padding: 32px 24px;
		}
	}
</style>
